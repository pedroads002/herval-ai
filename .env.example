# Copie este arquivo para .env.local e preencha com as chaves do seu projeto
# Supabase (Project Settings > Data API / API Keys). O .env.local não é
# versionado; este .env.example serve só de modelo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Envio manual do CRC pela tela de atendimento.
#
# Sem NEXT_PUBLIC_ de propósito: estas três só existem no servidor. O token é
# o que autoriza o painel a mandar WhatsApp — se ele fosse para o navegador,
# qualquer pessoa com o console aberto poderia enviar mensagem em nome da
# clínica.
#
# A URL é a do webhook "Entrada do painel" do workflow
# "Helô - Envio manual do CRC" no n8n. Enquanto essas duas estiverem vazias,
# a tela avisa que o envio não está configurado em vez de fingir que mandou.
N8N_ENVIO_URL=
N8N_ENVIO_TOKEN=
# Nome do cabeçalho combinado na credencial Header Auth do n8n.
# Só preencha se tiver usado um diferente do padrão.
N8N_ENVIO_HEADER=x-helo-token
